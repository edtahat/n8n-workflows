      "parameters": {
        "respondWith": "text",
        "responseBody": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Digital Maturity Assessment - Setup</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--bg:#fff;--surface-2:#f3f4f7;--surface-3:#e9ecf1;--border:#dde1e8;--soft:#e8eaef;--text:#1b222c;--dim:#5b6675;--faint:#8b95a5;--l1:#e2604b;--l2:#e2a24f;--l3:#c9a400;--l4:#5fae4e;--l5:#0aa88e;--danger:#c93b30;--display:'Space Grotesk',sans-serif;--body:'Inter',sans-serif;--mono:'JetBrains Mono',monospace}\n*{box-sizing:border-box}html,body{margin:0;padding:0}body{background:var(--bg);color:var(--text);font-family:var(--body);line-height:1.5;min-height:100vh;padding-bottom:64px}\n.supergraphic-strip{width:100%;height:8px;background:linear-gradient(90deg,#e20015 0 16%,#9e2896 16% 32%,#50237f 32% 48%,#007bc0 48% 64%,#18837e 64% 80%,#78be20 80%);margin-bottom:16px}\n.brand-header,.app{max-width:880px;margin:auto;padding-left:20px;padding-right:20px}\n.brand-header{padding-top:18px;display:flex;align-items:center}.brand-logo{height:28px;width:auto}.brand-logo-fallback{display:none;font-family:var(--display);font-weight:700;font-size:19px;color:#e2001a}\n.app{padding-top:24px}\n.eyebrow{font:12px var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--l5);display:flex;align-items:center;gap:8px;margin-bottom:14px}\n.eyebrow:before{content:\"\";width:6px;height:6px;border-radius:50%;background:var(--l5);box-shadow:0 0 0 3px rgba(10,168,142,.15)}\nh1{font:700 clamp(28px,4vw,38px) var(--display);letter-spacing:-.01em;margin:0 0 10px}\n.subtitle{color:var(--dim);font-size:15.5px;max-width:700px;margin:0 0 28px}\n.legend{display:flex;border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:28px}\n.legend-label{font:11px var(--mono);color:var(--faint);padding:10px 14px;display:flex;align-items:center;border-right:1px solid var(--border)}\n.legend-scale{display:flex;flex:1}\n.legend-chip{flex:1;padding:10px 8px;text-align:center;font:500 10.5px var(--mono);color:#0e1218}\n.legend-chip:nth-child(1){background:var(--l1)}.legend-chip:nth-child(2){background:var(--l2)}.legend-chip:nth-child(3){background:var(--l3)}.legend-chip:nth-child(4){background:var(--l4)}.legend-chip:nth-child(5){background:var(--l5)}\n.panel{background:#fff;border:1px solid var(--border);border-radius:16px;padding:28px;margin-bottom:18px}\n.panel-head{display:flex;align-items:baseline;gap:10px;margin-bottom:4px}\n.panel-num{font:12px var(--mono);color:var(--l5);border:1px solid var(--soft);background:var(--surface-2);border-radius:6px;padding:2px 7px}\n.panel-title{font:600 20px var(--display);margin:0}\n.panel-desc{color:var(--dim);font-size:14px;margin:0 0 22px}\nlabel{display:block;font-size:12.5px;font-weight:600;color:var(--dim);margin-bottom:6px}\ninput[type=text],input[type=email],input[type=date]{width:100%;background:var(--surface-2);border:1px solid var(--border);border-radius:9px;padding:11px 13px;color:var(--text);font:14.5px var(--body);outline:none}\ninput:focus{border-color:var(--l5);background:var(--surface-3)}\ninput[readonly]{cursor:default;color:var(--dim)}\n.field-row{margin-bottom:18px}\n.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n.row-item{display:grid;grid-template-columns:1.2fr 1.2fr .8fr auto;gap:10px;margin-bottom:10px;align-items:start}\n.row-item.activity-row{grid-template-columns:1.2fr 2.1fr auto}\n.btn-icon{width:38px;height:38px;border-radius:9px;border:1px solid var(--border);background:var(--surface-2);color:var(--faint);cursor:pointer}\n.btn-icon:hover{border-color:var(--danger);color:var(--danger)}\n.btn-add{display:inline-flex;background:transparent;border:1px dashed var(--border);color:var(--dim);padding:10px 16px;border-radius:9px;font-weight:600;cursor:pointer;margin-top:6px}\n.btn-add:hover{border-color:var(--l5);color:var(--l5)}\n.info-box{background:var(--surface-2);border:1px solid var(--soft);border-left:3px solid var(--l5);border-radius:10px;padding:16px 18px;font-size:13.5px;color:var(--dim);margin-bottom:22px}\ndetails.about{margin-bottom:22px}\ndetails.about summary{cursor:pointer;font-size:13.5px;font-weight:600;color:var(--l5)}\ndetails.about .about-body{padding-top:14px;font-size:13.5px;color:var(--dim)}\n.review-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:22px}\n.review-card{border:1px solid var(--border);background:var(--surface-2);border-radius:10px;padding:14px 16px}\n.review-card .num{font:700 20px var(--display);color:var(--l5);overflow-wrap:anywhere}\n.review-card .lbl{font-size:12px;color:var(--dim)}\n.section-sub{font:11px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--faint);margin:26px 0 12px;display:flex;align-items:center;gap:10px}\n.section-sub:after{content:\"\";flex:1;height:1px;background:var(--soft)}\n.activity-summary-card,.team-q,.dimension{border:1px solid var(--soft);background:var(--surface-2);border-radius:10px;padding:14px 16px;margin-bottom:10px}\n.activity-summary-card{border-left:3px solid var(--l5)}\n.activity-summary-name,.q-title{font-weight:600;font-size:13.5px}\n.activity-summary-desc,.q-opts{font-size:12.5px;color:var(--dim);margin-top:4px}\n.dimension-head{display:flex;gap:10px;margin-bottom:10px}\n.dimension-num{font:11px var(--mono);color:var(--faint)}\n.dimension-q{font-size:13.5px;font-weight:600}\n.matrix-table-wrap{overflow-x:auto}\ntable{border-collapse:collapse;width:100%;min-width:680px}\nth,td{border:1px solid var(--soft);padding:8px;font-size:11px;text-align:center}\nth:first-child,td:first-child{text-align:left;min-width:150px}\n.level-1{border-top:3px solid var(--l1)}.level-2{border-top:3px solid var(--l2)}.level-3{border-top:3px solid var(--l3)}.level-4{border-top:3px solid var(--l4)}.level-5{border-top:3px solid var(--l5)}\n.btn{font:600 14px var(--body);padding:12px 22px;border-radius:9px;border:1px solid transparent;cursor:pointer}\n.btn-primary{background:var(--l5);color:#0b1410}\n.btn:disabled{opacity:.4;cursor:not-allowed}\n.validation-msg{font-size:12.5px;color:var(--danger);margin-top:10px;min-height:16px}\n.status-msg{margin-top:16px;padding:12px 14px;border-radius:9px;font-size:13.5px;display:none}\n.status-msg.show{display:block}\n.status-msg.ok{background:rgba(10,168,142,.1);border:1px solid var(--l5);color:#067360}\n.status-msg.err{background:rgba(201,59,48,.1);border:1px solid var(--danger);color:var(--danger)}\n.status-msg.pending{background:var(--surface-2);border:1px solid var(--border);color:var(--dim)}\n.ac-wrap{position:relative}\n.ac-box{display:none;position:absolute;top:100%;left:0;right:0;background:#fff;border:1px solid var(--border);border-radius:9px;z-index:100;max-height:240px;overflow-y:auto;box-shadow:0 6px 18px rgba(0,0,0,.12)}\n.ac-box.show{display:block}\n.ac-item{padding:9px 13px;cursor:pointer;border-bottom:1px solid var(--soft)}\n.ac-item:last-child{border-bottom:none}\n.ac-item:hover,.ac-item.active{background:var(--surface-2)}\n.ac-name{font-weight:600;font-size:13.5px}\n.ac-meta{font-size:11.5px;color:var(--dim)}\n.ac-state{padding:9px 13px;font-size:12.5px;color:var(--faint)}\n.ac-hint{font-size:11.5px;color:var(--faint);margin-top:5px;min-height:15px}\n.ac-hint.err{color:var(--danger)}\n@media(max-width:680px){.field-grid,.review-summary,.row-item,.row-item.activity-row{grid-template-columns:1fr}.legend{display:none}.panel{padding:20px}}\n</style>\n</head>\n<body>\n<div class=\"supergraphic-strip\"></div>\n<div class=\"brand-header\"><img src=\"REPLACE_WITH_LOGO_URL\" alt=\"Company logo\" class=\"brand-logo\" onerror=\"this.style.display='none';document.getElementById('logoFallback').style.display='inline-block'\"><span id=\"logoFallback\" class=\"brand-logo-fallback\">BOSCH</span></div>\n<main class=\"app\">\n<div class=\"eyebrow\">Digital Maturity Program &middot; n8n workflow trigger</div>\n<h1>Digital Maturity Assessment - Setup</h1>\n<p class=\"subtitle\">Configure a new maturity assessment, respondents and core activities on a single page. The complete setup is submitted as JSON to n8n.</p>\n<div class=\"legend\"><div class=\"legend-label\">MATURITY SCALE</div><div class=\"legend-scale\"><div class=\"legend-chip\">1 &middot; Document Driven</div><div class=\"legend-chip\">2 &middot; System Driven</div><div class=\"legend-chip\">3 &middot; Data Driven</div><div class=\"legend-chip\">4 &middot; Predictive Driven</div><div class=\"legend-chip\">5 &middot; AI Driven</div></div></div>\n<form id=\"assessmentForm\" novalidate>\n\n<section class=\"panel\">\n<div class=\"panel-head\"><span class=\"panel-num\">01</span><h2 class=\"panel-title\">Requester</h2></div>\n<p class=\"panel-desc\">Start typing the name and pick the person from the directory. Email and department are filled in automatically.</p>\n<details class=\"about\"><summary>About this assessment</summary><div class=\"about-body\"><p><strong>Objective.</strong> Assess the digital maturity of the department's core processes. The focus is on the process, not the people.</p><ul><li>Answer based on the current reality.</li><li>Consider the process end-to-end.</li><li>Select the most common practice when execution varies.</li></ul></div></details>\n<div class=\"field-grid field-row\">\n<div class=\"ac-wrap\"><label for=\"reqName\">Requested by *</label><input type=\"text\" id=\"reqName\" name=\"requestedBy\" required placeholder=\"Type at least 2 letters to search...\" autocomplete=\"off\" role=\"combobox\" aria-autocomplete=\"list\" aria-expanded=\"false\" aria-controls=\"reqSuggestions\"><div id=\"reqSuggestions\" class=\"ac-box\" role=\"listbox\"></div><div class=\"ac-hint\" id=\"reqHint\"></div><input type=\"hidden\" id=\"reqUserId\" name=\"requestedById\"><input type=\"hidden\" id=\"reqJobTitle\" name=\"requestedByJobTitle\"></div>\n<div><label for=\"reqEmail\">Email *</label><input type=\"email\" id=\"reqEmail\" name=\"requestedByEmail\" required placeholder=\"name@company.com\"></div>\n</div>\n<div class=\"field-grid field-row\">\n<div><label for=\"reqDepartment\">Department / area</label><input type=\"text\" id=\"reqDepartment\" name=\"requestedByDepartment\" placeholder=\"Filled from the directory\" readonly></div>\n<div><label for=\"targetDate\">Validity date *</label><input type=\"date\" id=\"targetDate\" name=\"targetDate\" required></div>\n</div>\n</section>\n\n<section class=\"panel\">\n<div class=\"panel-head\"><span class=\"panel-num\">02</span><h2 class=\"panel-title\">Who will receive the form</h2></div>\n<p class=\"panel-desc\">Add everyone who should complete the assessment. Names are searched in the directory as well.</p>\n<div id=\"respondentsList\"></div>\n<button type=\"button\" class=\"btn-add\" id=\"addRespondentBtn\">+ Add respondent</button>\n</section>\n\n<section class=\"panel\">\n<div class=\"panel-head\"><span class=\"panel-num\">03</span><h2 class=\"panel-title\">Core activities to evaluate</h2></div>\n<p class=\"panel-desc\">Each activity will be scored against all maturity dimensions.</p>\n<div class=\"info-box\"><strong>Tip:</strong> keep names short and recognizable. Use the description for systems, scope or acronyms.</div>\n<div id=\"activitiesList\"></div>\n<button type=\"button\" class=\"btn-add\" id=\"addActivityBtn\">+ Add activity</button>\n</section>\n\n<section class=\"panel\">\n<div class=\"panel-head\"><span class=\"panel-num\">04</span><h2 class=\"panel-title\">Framework &amp; send</h2></div>\n<p class=\"panel-desc\">Review the setup and submit it to n8n.</p>\n<div class=\"review-summary\">\n<div class=\"review-card\"><div class=\"num\" id=\"reviewDept\">-</div><div class=\"lbl\">Department</div></div>\n<div class=\"review-card\"><div class=\"num\" id=\"reviewResp\">0</div><div class=\"lbl\">Respondents</div></div>\n<div class=\"review-card\"><div class=\"num\" id=\"reviewAct\">0</div><div class=\"lbl\">Core activities</div></div>\n</div>\n<details class=\"about\"><summary>Preview the full maturity framework</summary><div class=\"about-body\">\n<div class=\"section-sub\">Core activities</div><div id=\"frameworkActivities\"></div>\n<div class=\"section-sub\">Per-activity dimensions</div><div id=\"frameworkDims\"></div>\n<div class=\"section-sub\">Team-level questions</div><div id=\"frameworkTeam\"></div>\n<div class=\"section-sub\">Open questions</div><div id=\"frameworkOpen\"></div>\n</div></details>\n<div class=\"section-sub\">Confirm &amp; send</div>\n<button type=\"submit\" class=\"btn btn-primary\" id=\"submitBtn\">Send forms</button>\n<div class=\"validation-msg\" id=\"formError\"></div>\n<div class=\"status-msg\" id=\"statusMsg\" role=\"status\" aria-live=\"polite\"></div>\n</section>\n\n</form>\n</main>\n<script>\n'use strict';\nvar WEBHOOK_BASE=location.origin+(location.pathname.indexOf('/webhook-test/')!==-1?'/webhook-test':'/webhook');\nvar SUBMIT_ENDPOINT=WEBHOOK_BASE+'/5e0f338d-9b2b-48dd-9d39-8dc301798212';\nvar PEOPLE_WEBHOOK=WEBHOOK_BASE+'/c7fe0be6-d5d8-4bd5-8308-e16398916e6f';\nconst FRAMEWORK={dimensions:[\n{id:'execution_method',question:'How are the activities of this process currently performed?',levels:['Fully manual (spreadsheets, emails, local controls)','Partially digital, with heavy manual intervention','Some automation, but frequent rework still occurs','Mostly automated and standardized','Fully automated, with minimal human intervention']},\n{id:'manual_effort',question:'What level of manual effort is required to execute the process?',levels:['Very high - depends entirely on manual activities','High - large part manual','Medium - balance between manual and automated','Low - little manual intervention','Very low - process is practically automatic']},\n{id:'data_usage',question:'How is data used in this process?',levels:['Only recorded as information','Basic manual reports','Structured dashboards for monitoring','Analysis to identify trends and root causes','Predictive analytics or automatic recommendations']},\n{id:'insight_generation',question:'Does the process generate relevant insights from the data?',levels:['Generates no insights','Occasional, limited insights','Recurring insights based on data','Clear identification of trends and root causes','Anticipation of problems based on data']},\n{id:'system_integration',question:'How are the systems used in the process connected?',levels:['No integration - data transferred manually','Limited integrations, dependent on manual extracts','Partial integration between systems','Well-integrated systems','Full, automatic integration - no manual intervention']},\n{id:'rework',question:'Is there rework in the information flow (copy/paste, reprocessing)?',levels:['Very frequent','Frequent','Occasional','Rare','Nonexistent']},\n{id:'decision_basis',question:'How are decisions made in this process?',levels:['Based on individual experience / judgment','Based on historical reports','Based on structured indicators','Based on up-to-date data / real-time analysis','Based on automatic forecasts / recommendations']},\n{id:'preventive_capability',question:'Does the process have the capability to act preventively?',levels:['Fully reactive','Slightly anticipatory','Partially anticipatory','Frequently anticipatory','Highly predictive / proactive']},\n{id:'performance_impact',question:'Does the process contribute to performance improvement?',levels:['No relevant impact','Small, occasional gains','Consistent improvement','Relevant impact on results','Strategic impact for the business']},\n{id:'kpi_measurement',question:'Is the value generated measured through indicators (KPIs)?',levels:['Not measured','Poorly measured','Partially measured','Well measured, with clear indicators','Measured and continuously monitored with targets']}\n],teamQuestions:[\n{id:'team_digital_skills',question:'Does the team have skills in digital tools and data analysis?',options:['Very limited','Basic','Intermediate','Advanced','Expert']},\n{id:'team_autonomy',question:'Is the team autonomous in developing digital solutions?',options:['Fully dependent','Highly dependent','Partially autonomous','Mostly autonomous','Fully autonomous']},\n{id:'team_reaction',question:'How does the team respond to digital initiatives?',options:['Resistant','Reactive','Neutral','Proactive','Consolidated digital culture']}\n],openQuestions:['Which process do you consider most critical for digital improvement?','Where are the biggest inefficiencies / waste today?']};\nconst state={respondents:[{name:'',email:'',role:''}],activities:[{name:'',description:''}]};\nconst $=id=>document.getElementById(id);\nconst escapeHtml=value=>String(value==null?'':value).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst isValidEmail=value=>/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(value);\n\n/* ---------- People search (People Search Webhook -> Microsoft Entra) ---------- */\nfunction normalizePerson(item){\n  const person=(item&&item.json&&typeof item.json==='object')?item.json:(item||{});\n  let name=person.displayName||person.name||'';\n  let department=person.department||'';\n  const bracket=name.match(/\\(([^)]+)\\)$/);\n  if(bracket&&!department){department=bracket[1];name=name.replace(/\\s*\\([^)]+\\)$/,'').trim()}\n  return{id:person.id||'',name:name,email:person.mail||person.email||person.userPrincipalName||'',department:department,jobTitle:person.jobTitle||''};\n}\nasync function searchPeople(term){\n  const response=await fetch(PEOPLE_WEBHOOK,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({name:term})});\n  if(!response.ok)throw new Error('HTTP '+response.status);\n  const text=await response.text();\n  if(!text.trim())return[];\n  let raw;try{raw=JSON.parse(text)}catch(e){throw new Error('Unexpected response from the people search webhook.')}\n  const list=Array.isArray(raw)?raw:(Array.isArray(raw.data)?raw.data:(raw&&typeof raw==='object'?[raw]:[]));\n  return list.map(normalizePerson).filter(p=>p.name||p.email);\n}\nfunction attachPeopleSearch(input,options){\n  const box=options.box,hint=options.hint||null,onSelect=options.onSelect;\n  let results=[],activeIndex=-1,timer=null,sequence=0;\n  const setHint=(msg,isError)=>{if(hint){hint.textContent=msg||'';hint.className='ac-hint'+(isError?' err':'')}};\n  const close=()=>{box.classList.remove('show');box.innerHTML='';input.setAttribute('aria-expanded','false');activeIndex=-1};\n  const open=()=>{box.style.top=(input.offsetTop+input.offsetHeight+4)+'px';box.classList.add('show');input.setAttribute('aria-expanded','true')};\n  const paint=()=>{\n    box.innerHTML=results.map((p,i)=>'<div class=\"ac-item'+(i===activeIndex?' active':'')+'\" role=\"option\" data-i=\"'+i+'\"><div class=\"ac-name\">'+escapeHtml(p.name)+'</div><div class=\"ac-meta\">'+escapeHtml([p.email,p.department,p.jobTitle].filter(Boolean).join(' · '))+'</div></div>').join('');\n    open();\n  };\n  const showState=text=>{box.innerHTML='<div class=\"ac-state\">'+escapeHtml(text)+'</div>';open()};\n  const choose=index=>{const person=results[index];if(!person)return;close();setHint('');onSelect(person)};\n  input.addEventListener('input',()=>{\n    const term=input.value.trim();\n    setHint('');\n    if(options.onType)options.onType(input.value);\n    clearTimeout(timer);\n    if(term.length<2){close();return}\n    const mySequence=++sequence;\n    showState('Searching directory...');\n    timer=setTimeout(async()=>{\n      try{\n        const people=await searchPeople(term);\n        if(mySequence!==sequence)return;\n        results=people;activeIndex=-1;\n        if(!people.length){showState('No user found for \"'+term+'\".');return}\n        paint();\n      }catch(error){\n        if(mySequence!==sequence)return;\n        console.error('People search failed:',error);\n        results=[];close();setHint('Directory search unavailable - type the details manually.',true);\n      }\n    },250);\n  });\n  input.addEventListener('keydown',event=>{\n    if(!box.classList.contains('show')||!results.length){if(event.key==='Escape')close();return}\n    if(event.key==='ArrowDown'){event.preventDefault();activeIndex=(activeIndex+1)%results.length;paint()}\n    else if(event.key==='ArrowUp'){event.preventDefault();activeIndex=(activeIndex-1+results.length)%results.length;paint()}\n    else if(event.key==='Enter'&&activeIndex>=0){event.preventDefault();choose(activeIndex)}\n    else if(event.key==='Escape'){close()}\n  });\n  box.addEventListener('mousedown',event=>{const item=event.target.closest('.ac-item');if(!item)return;event.preventDefault();choose(Number(item.dataset.i))});\n  input.addEventListener('blur',()=>setTimeout(close,150));\n}\n\n/* ---------- Requester ---------- */\nlet requesterPerson=null;\nattachPeopleSearch($('reqName'),{\n  box:$('reqSuggestions'),hint:$('reqHint'),\n  onType:value=>{\n    if(requesterPerson&&value.trim()===requesterPerson.name)return;\n    requesterPerson=null;\n    $('reqUserId').value='';$('reqJobTitle').value='';$('reqDepartment').value='';\n    $('reqHint').className='ac-hint';\n    $('reqHint').textContent=value.trim()?'Pick the person from the list to fill email and department automatically.':'';\n    renderReview();\n  },\n  onSelect:person=>{\n    requesterPerson=person;\n    $('reqName').value=person.name;\n    $('reqEmail').value=person.email;\n    $('reqDepartment').value=person.department;\n    $('reqUserId').value=person.id;\n    $('reqJobTitle').value=person.jobTitle;\n    $('reqHint').className='ac-hint';\n    $('reqHint').textContent=person.department?'':'This user has no department in the directory.';\n    renderReview();\n  }\n});\n\n/* ---------- Respondents & activities ---------- */\nfunction renderRespondents(){\n  $('respondentsList').innerHTML=state.respondents.map((r,i)=>'<div class=\"row-item\"><div class=\"ac-wrap\"><input type=\"text\" aria-label=\"Respondent name\" placeholder=\"Type to search...\" autocomplete=\"off\" value=\"'+escapeHtml(r.name)+'\" data-r-index=\"'+i+'\" data-r-field=\"name\"><div class=\"ac-box\" role=\"listbox\" data-r-box=\"'+i+'\"></div></div><input type=\"email\" aria-label=\"Respondent email\" placeholder=\"Email address\" value=\"'+escapeHtml(r.email)+'\" data-r-index=\"'+i+'\" data-r-field=\"email\"><input type=\"text\" aria-label=\"Respondent role\" placeholder=\"Role (optional)\" value=\"'+escapeHtml(r.role)+'\" data-r-index=\"'+i+'\" data-r-field=\"role\"><button type=\"button\" class=\"btn-icon\" data-remove-r=\"'+i+'\" aria-label=\"Remove respondent\">X</button></div>').join('');\n  state.respondents.forEach((r,i)=>{\n    const row=$('respondentsList').children[i];\n    attachPeopleSearch(row.querySelector('[data-r-field=\"name\"]'),{\n      box:row.querySelector('[data-r-box]'),\n      onSelect:person=>{\n        state.respondents[i]={name:person.name,email:person.email,role:person.jobTitle||state.respondents[i].role};\n        row.querySelector('[data-r-field=\"name\"]').value=state.respondents[i].name;\n        row.querySelector('[data-r-field=\"email\"]').value=state.respondents[i].email;\n        row.querySelector('[data-r-field=\"role\"]').value=state.respondents[i].role;\n        renderReview();\n      }\n    });\n  });\n  renderReview();\n}\nfunction renderActivities(){\n  $('activitiesList').innerHTML=state.activities.map((a,i)=>'<div class=\"row-item activity-row\"><input type=\"text\" aria-label=\"Activity name\" placeholder=\"Activity name\" value=\"'+escapeHtml(a.name)+'\" data-a-index=\"'+i+'\" data-a-field=\"name\"><input type=\"text\" aria-label=\"Activity description\" placeholder=\"Short description (optional)\" value=\"'+escapeHtml(a.description)+'\" data-a-index=\"'+i+'\" data-a-field=\"description\"><button type=\"button\" class=\"btn-icon\" data-remove-a=\"'+i+'\" aria-label=\"Remove activity\">X</button></div>').join('');\n  renderFramework();\n}\n$('respondentsList').addEventListener('input',e=>{const i=e.target.dataset.rIndex;if(i!==undefined){state.respondents[Number(i)][e.target.dataset.rField]=e.target.value;renderReview()}});\n$('respondentsList').addEventListener('click',e=>{if(e.target.dataset.removeR!==undefined){const i=Number(e.target.dataset.removeR);state.respondents.length===1?state.respondents[0]={name:'',email:'',role:''}:state.respondents.splice(i,1);renderRespondents()}});\n$('activitiesList').addEventListener('input',e=>{const i=e.target.dataset.aIndex;if(i!==undefined){state.activities[Number(i)][e.target.dataset.aField]=e.target.value;renderFramework()}});\n$('activitiesList').addEventListener('click',e=>{if(e.target.dataset.removeA!==undefined){const i=Number(e.target.dataset.removeA);state.activities.length===1?state.activities[0]={name:'',description:''}:state.activities.splice(i,1);renderActivities()}});\n$('addRespondentBtn').addEventListener('click',()=>{state.respondents.push({name:'',email:'',role:''});renderRespondents()});\n$('addActivityBtn').addEventListener('click',()=>{state.activities.push({name:'',description:''});renderActivities()});\n$('reqDepartment').addEventListener('input',renderReview);\n\n/* ---------- Review & framework preview ---------- */\nfunction renderReview(){\n  $('reviewDept').textContent=$('reqDepartment').value.trim()||'-';\n  $('reviewResp').textContent=state.respondents.filter(r=>r.name.trim()&&isValidEmail(r.email.trim())).length;\n  $('reviewAct').textContent=state.activities.filter(a=>a.name.trim()).length;\n}\nfunction renderFramework(){\n  const acts=state.activities.filter(a=>a.name.trim());\n  $('frameworkActivities').innerHTML=acts.map(a=>'<div class=\"activity-summary-card\"><div class=\"activity-summary-name\">'+escapeHtml(a.name)+'</div>'+(a.description.trim()?'<div class=\"activity-summary-desc\">'+escapeHtml(a.description)+'</div>':'')+'</div>').join('');\n  $('frameworkDims').innerHTML=FRAMEWORK.dimensions.map((d,di)=>'<div class=\"dimension\"><div class=\"dimension-head\"><span class=\"dimension-num\">D'+(di+1)+'</span><span class=\"dimension-q\">'+escapeHtml(d.question)+'</span></div><div class=\"matrix-table-wrap\"><table><thead><tr><th>Core activity</th>'+d.levels.map((l,i)=>'<th class=\"level-'+(i+1)+'\">'+escapeHtml(l)+'</th>').join('')+'</tr></thead><tbody>'+acts.map(a=>'<tr><td>'+escapeHtml(a.name)+'</td>'+d.levels.map(()=>'<td>&#9675;</td>').join('')+'</tr>').join('')+'</tbody></table></div></div>').join('');\n  $('frameworkTeam').innerHTML=FRAMEWORK.teamQuestions.map(q=>'<div class=\"team-q\"><div class=\"q-title\">'+escapeHtml(q.question)+'</div><div class=\"q-opts\">'+q.options.map((o,i)=>(i+1)+'. '+escapeHtml(o)).join(' · ')+'</div></div>').join('');\n  $('frameworkOpen').innerHTML=FRAMEWORK.openQuestions.map(q=>'<div class=\"team-q\"><div class=\"q-title\">'+escapeHtml(q)+'</div><div class=\"q-opts\">Free-text response</div></div>').join('');\n  renderReview();\n}\n\n/* ---------- Validation & submit ---------- */\nfunction validateForm(){\n  if(!$('reqName').value.trim())return{msg:'Enter the requester name.',focus:'reqName'};\n  if(!isValidEmail($('reqEmail').value.trim()))return{msg:'Enter a valid requester email.',focus:'reqEmail'};\n  if(!$('targetDate').value)return{msg:'Select the validity date.',focus:'targetDate'};\n  if(!state.respondents.some(r=>r.name.trim()&&isValidEmail(r.email.trim())))return{msg:'Add at least one respondent with a valid name and email.',focus:'addRespondentBtn'};\n  if(!state.activities.some(a=>a.name.trim()))return{msg:'Add at least one core activity.',focus:'addActivityBtn'};\n  return null;\n}\nfunction buildPayload(){\n  const department=$('reqDepartment').value.trim();\n  return{\n    formType:'digital_maturity_assessment_setup',\n    submittedAt:new Date().toISOString(),\n    department:{\n      name:department,\n      targetDate:$('targetDate').value,\n      requestedBy:$('reqName').value.trim(),\n      requestedByEmail:$('reqEmail').value.trim(),\n      requestedByDepartment:department,\n      requestedByJobTitle:$('reqJobTitle').value,\n      requestedById:$('reqUserId').value\n    },\n    respondents:state.respondents.filter(r=>r.name.trim()&&isValidEmail(r.email.trim())).map(r=>({name:r.name.trim(),email:r.email.trim(),role:r.role.trim()})),\n    activities:state.activities.filter(a=>a.name.trim()).map(a=>({name:a.name.trim(),description:a.description.trim()})),\n    maturityFramework:FRAMEWORK\n  };\n}\nfunction setStatus(kind,msg){$('statusMsg').className='status-msg show '+kind;$('statusMsg').textContent=msg}\n$('assessmentForm').addEventListener('submit',async e=>{\n  e.preventDefault();\n  const invalid=validateForm();\n  $('formError').textContent=invalid?invalid.msg:'';\n  if(invalid){const el=$(invalid.focus);if(el){el.focus();el.scrollIntoView({block:'center',behavior:'smooth'})}return}\n  const button=$('submitBtn');button.disabled=true;setStatus('pending','Sending data to n8n...');\n  try{\n    const response=await fetch(SUBMIT_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(buildPayload())});\n    const responseText=await response.text();\n    if(!response.ok)throw new Error('HTTP '+response.status+(responseText?': '+responseText.slice(0,300):''));\n    setStatus('ok','Assessment setup sent successfully to n8n.');\n  }catch(error){\n    console.error(error);\n    setStatus('err','The form could not be submitted. '+(error.message||'Check the webhook and browser CORS policy.'));\n  }finally{button.disabled=false}\n});\n\nrenderRespondents();renderActivities();\n</script>\n</body>\n</html>\n",
