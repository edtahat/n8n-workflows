      "name": "Fetch CNPJ",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Normaliza a resposta da API publica e deixa o erro visivel para a interface.\n// Entende o formato da BrasilAPI e o da ReceitaWS, entao trocar de provedor nao quebra o form.\nconst prepared = $('Prepare CNPJ').first().json;\nconst raw = $input.first().json || {};\nlet error = '';\n\nif (raw.error) {\n  error = typeof raw.error === 'string' ? raw.error : (raw.error.message || JSON.stringify(raw.error));\n} else if (!raw.cnpj && !raw.razao_social && !raw.nome) {\n  error = raw.message || raw.detalhes || raw.type || 'CNPJ nao encontrado.';\n}\n\nconst first = (...values) => values.find((v) => v !== undefined && v !== null && v !== '') || '';\nconst atividade = Array.isArray(raw.atividade_principal) ? (raw.atividade_principal[0] || {}) : {};\n\nconst company = error ? null : {\n  cnpj: prepared.cnpj,\n  cnpjFormatted: prepared.cnpjFormatted,\n  razaoSocial: first(raw.razao_social, raw.nome),\n  nomeFantasia: first(raw.nome_fantasia, raw.fantasia),\n  situacao: first(raw.descricao_situacao_cadastral, raw.situacao),\n  dataAbertura: first(raw.data_inicio_atividade, raw.abertura),\n  atividadePrincipal: first(raw.cnae_fiscal_descricao, atividade.text),\n  porte: first(raw.descricao_porte, raw.porte),\n  logradouro: first(raw.logradouro),\n  numero: first(raw.numero),\n  bairro: first(raw.bairro),\n  municipio: first(raw.municipio),\n  uf: first(raw.uf),\n  cep: first(raw.cep),\n  telefone: first(raw.ddd_telefone_1, raw.telefone),\n  email: first(raw.email),\n};\n\nreturn [{\n  json: {\n    ok: !error,\n    cnpj: prepared.cnpj,\n    cnpjFormatted: prepared.cnpjFormatted,\n    error,\n    company,\n  },\n}];\n"
      },
