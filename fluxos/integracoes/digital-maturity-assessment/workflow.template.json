    {
      "parameters": {
        "jsCode": "// Normaliza a saida do Entra e deixa visivel qualquer erro da API,\n// em vez de devolver uma lista vazia que a interface leria como \"nenhum usuario\".\nconst term = $('Prepare Search Term').first().json.searchTerm || '';\nconst people = [];\nlet error = '';\n\nfor (const item of $input.all()) {\n  const user = item.json || {};\n\n  if (user.error) {\n    const detail = user.error;\n    error = typeof detail === 'string' ? detail : (detail.message || JSON.stringify(detail));\n    continue;\n  }\n  if (!user.displayName && !user.mail && !user.userPrincipalName) continue;\n\n  people.push({\n    id: user.id || '',\n    displayName: user.displayName || '',\n    mail: user.mail || user.userPrincipalName || '',\n    department: user.department || '',\n    jobTitle: user.jobTitle || '',\n  });\n}\n\nreturn [{ json: { ok: !error, term, count: people.length, people, error } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2592,
