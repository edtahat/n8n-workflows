      "name": "CNPJ Webhook",
      "webhookId": "3f0a5c21-9b7e-4d58-a0c6-71e2d4f8b913"
    },
    {
      "parameters": {
        "jsCode": "// Sanitiza e valida o CNPJ antes de gastar uma chamada na API.\n// Aceita o formato numerico e o CNPJ alfanumerico (12 caracteres + 2 digitos verificadores),\n// em que o valor de cada caractere e o codigo ASCII menos 48.\nconst input = $input.first().json || {};\nconst query = input.query || {};\nconst body = input.body || {};\nconst cnpj = String(query.cnpj || query.q || body.cnpj || body.q || '')\n  .toUpperCase()\n  .replace(/[^A-Z0-9]/g, '');\n\nfunction isValid(value) {\n  if (value.length !== 14) return false;\n  if (/^(.)\\1{13}$/.test(value)) return false;\n  if (!/^[A-Z0-9]{12}[0-9]{2}$/.test(value)) return false;\n\n  const valueOf = (char) => char.charCodeAt(0) - 48;\n  const checkDigit = (base) => {\n    let weight = base.length - 7;\n    let sum = 0;\n    for (let i = 0; i < base.length; i++) {\n      sum += valueOf(base[i]) * weight--;\n      if (weight < 2) weight = 9;\n    }\n    const rest = sum % 11;\n    return rest < 2 ? 0 : 11 - rest;\n  };\n\n  return checkDigit(value.slice(0, 12)) === Number(value[12])\n    && checkDigit(value.slice(0, 13)) === Number(value[13]);\n}\n\nconst formatted = cnpj.length === 14\n  ? `${cnpj.slice(0, 2)}.${cnpj.slice(2, 5)}.${cnpj.slice(5, 8)}/${cnpj.slice(8, 12)}-${cnpj.slice(12)}`\n  : cnpj;\nconst valid = isValid(cnpj);\n\nreturn [{\n  json: {\n    cnpj,\n    cnpjFormatted: formatted,\n    valid,\n    ok: valid,\n    error: valid ? '' : (cnpj ? 'CNPJ invalido: ' + formatted : 'Informe o CNPJ.'),\n    company: null,\n  },\n}];\n"
      },
